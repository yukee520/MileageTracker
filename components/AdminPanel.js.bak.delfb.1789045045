import React, { useState, useEffect, useRef } from 'react';
import {
  StyleSheet,
  View,
  Text,
  TouchableOpacity,
  ScrollView,
  ActivityIndicator,
  Alert,
  Modal,
  TextInput,
  FlatList,
  RefreshControl
} from 'react-native';
import { createClient } from '@supabase/supabase-js';
import DateTimePicker from '@react-native-community/datetimepicker';
import FeedbackService from '../services/FeedbackService';

const SUPABASE_URL = 'https://dkpjicqepexhgbrzzreo.supabase.co';
const SUPABASE_ANON_KEY = 'sb_publishable_7CXIRyhWhmsQfRfj9dDhWw_Z2efV6fx';
const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

const AdminPanel = ({ user, onClose }) => {
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [users, setUsers] = useState([]);
  const [trips, setTrips] = useState([]);
  const [teams, setTeams] = useState([]);
  const [stats, setStats] = useState({});
  const [editingUser, setEditingUser] = useState(null);
  const [editName, setEditName] = useState('');
  const [editRole, setEditRole] = useState('');
  const [editEmail, setEditEmail] = useState('');
  const [editTeamId, setEditTeamId] = useState('');
  const [editTier, setEditTier] = useState('');
  const [editExpiryDate, setEditExpiryDate] = useState(new Date());
  const [showEditModal, setShowEditModal] = useState(false);
  const [view, setView] = useState('dashboard');
  const [feedback, setFeedback] = useState([]);
  const [showDatePicker, setShowDatePicker] = useState(false);

  const isMounted = useRef(true);
  const isLoadingRef = useRef(false);

  const SUBSCRIPTION_TIERS = [
    { label: 'Personal Free', value: 'personal_free', limit: 30, isGroup: false },
    { label: 'Personal Basic', value: 'personal_basic', limit: 100, isGroup: false },
    { label: 'Personal Pro', value: 'personal_pro', limit: 99999, isGroup: false },
    { label: 'Group Basic', value: 'team_basic', limit: 100, isGroup: true },
    { label: 'Group Pro', value: 'team_pro', limit: 99999, isGroup: true }
  ];

  useEffect(() => {
    isMounted.current = true;
    loadData();
    return () => {
      isMounted.current = false;
    };
  }, []);

  const loadData = async () => {
    if (isLoadingRef.current) {
      console.log('⏳ AdminPanel: Already loading, skipping...');
      return;
    }

    try {
      isLoadingRef.current = true;
      setLoading(true);
      console.log('📊 AdminPanel: Loading data...');

      const { data: allUsers, error: usersError } = await supabase
        .from('profiles')
        .select('*')
        .order('created_at', { ascending: false });

      if (usersError) {
        console.error('❌ AdminPanel: Users error:', usersError);
        if (isMounted.current) setLoading(false);
        return;
      }

      // Get subscription info - from profiles for personal plans, from teams for group plans
      const usersWithSubscriptions = await Promise.all((allUsers || []).map(async (user) => {
        let subscriptionTier = user.subscription_tier || 'personal_free';
        let subscriptionEndDate = user.subscription_expiry || null;
        let teamInfo = null;

        // If user has a team, check if it's a group team
        if (user.team_id) {
          const { data: team, error: teamError } = await supabase
            .from('teams')
            .select('subscription_tier, subscription_end_date, name, max_members')
            .eq('id', user.team_id)
            .single();

          if (!teamError && team) {
            const isGroupTeam = team.max_members > 1 || 
                               team.subscription_tier === 'team_basic' || 
                               team.subscription_tier === 'team_pro';
            
            if (isGroupTeam) {
              subscriptionTier = team.subscription_tier || 'personal_free';
              subscriptionEndDate = team.subscription_end_date;
              teamInfo = team;
            }
          }
        }

        // Map subscription tier to display name
        const tierDisplay = {
          'personal_free': 'Personal Free',
          'personal_basic': 'Personal Basic',
          'personal_pro': 'Personal Pro',
          'team_basic': 'Group Basic',
          'team_pro': 'Group Pro'
        };

        return {
          ...user,
          subscription_tier: tierDisplay[subscriptionTier] || 'Personal Free',
          subscription_end_date: subscriptionEndDate,
          team_name: teamInfo?.name || null,
          is_group_team: teamInfo?.max_members > 1
        };
      }));

      if (isMounted.current) {
        setUsers(usersWithSubscriptions || []);
      }

      const { data: allTrips, error: tripsError } = await supabase
        .from('trip_logs')
        .select('*, profiles!trip_logs_user_id_fkey(full_name, email)')
        .order('created_at', { ascending: false })
        .limit(100);

      if (!tripsError && isMounted.current) {
        setTrips(allTrips || []);
      }

      const { data: allTeams, error: teamsError } = await supabase
        .from('teams')
        .select('*, profiles!teams_created_by_fkey(full_name, email)')
        .order('created_at', { ascending: false });

      if (!teamsError && isMounted.current) {
        setTeams(allTeams || []);
      }

      const fb = await FeedbackService.getAllFeedback();
      if (isMounted.current) setFeedback(fb || []);

      if (isMounted.current) {
        const totalTrips = allTrips?.length || 0;
        const totalDistance = allTrips?.reduce((sum, t) => sum + parseFloat(t.distance_km || 0), 0) || 0;
        const usersWithGroups = allUsers?.filter(u => u.team_id).length || 0;

        setStats({
          totalUsers: allUsers?.length || 0,
          totalTrips: totalTrips,
          totalDistance: totalDistance.toFixed(1),
          usersInGroups: usersWithGroups,
          totalTeams: allTeams?.length || 0
        });
      }

      console.log('✅ AdminPanel: Data loaded successfully');

    } catch (error) {
      console.error('❌ AdminPanel: Error:', error);
      if (isMounted.current) {
        Alert.alert('Error', 'Failed to load admin data: ' + error.message);
      }
    } finally {
      if (isMounted.current) {
        setLoading(false);
        setRefreshing(false);
      }
      isLoadingRef.current = false;
    }
  };

  const onRefresh = () => {
    setRefreshing(true);
    loadData();
  };

  // ============================================================
  // UPDATE USER SUBSCRIPTION - FIXED: Saves to profiles table
  // ============================================================
  const handleUpdateSubscription = async () => {
    if (!editingUser) return;

    try {
      console.log('📝 Updating subscription for:', editingUser.email);
      console.log('📊 Tier:', editTier);
      console.log('📅 Expiry:', editExpiryDate);
      console.log('🏷️ Team ID:', editTeamId);

      const isGroup = editTier === 'team_basic' || editTier === 'team_pro';
      const isPersonal = editTier === 'personal_free' || editTier === 'personal_basic' || editTier === 'personal_pro';

      let teamId = editTeamId || editingUser.team_id || null;

      // ============================================================
      // GROUP PLAN - Needs a team
      // ============================================================
      if (isGroup) {
        console.log('🏗️ Group plan - managing team...');
        
        if (!teamId) {
          // Create a new group team
          console.log('🏗️ Creating new group team...');
          const teamName = `${editingUser.full_name || editingUser.email}'s Group`;
          const uniqueId = Date.now().toString(36);
          const { data: newTeam, error: teamError } = await supabase
            .from('teams')
            .insert({
              name: teamName,
              group_name: `${teamName.toLowerCase().replace(/\s+/g, '-')}-${uniqueId}`,
              subscription_tier: editTier,
              monthly_trip_limit: editTier === 'team_basic' ? 100 : 99999,
              max_members: editTier === 'team_basic' ? 10 : 25,
              payment_status: 'active',
              subscription_end_date: editExpiryDate.toISOString(),
              created_by: editingUser.id
            })
            .select()
            .single();

          if (teamError) throw teamError;
          teamId = newTeam.id;
          console.log('✅ Group team created:', teamId);
        } else {
          // Update existing team
          console.log('🔄 Updating existing group team...');
          const { error: teamUpdateError } = await supabase
            .from('teams')
            .update({
              subscription_tier: editTier,
              monthly_trip_limit: editTier === 'team_basic' ? 100 : 99999,
              max_members: editTier === 'team_basic' ? 10 : 25,
              payment_status: 'active',
              subscription_end_date: editExpiryDate.toISOString()
            })
            .eq('id', teamId);

          if (teamUpdateError) throw teamUpdateError;
        }

        // Update user's team_id
        const { error: updateError } = await supabase
          .from('profiles')
          .update({ 
            team_id: teamId,
            role: editingUser.role || 'member',
            subscription_tier: editTier,
            subscription_expiry: editExpiryDate.toISOString()
          })
          .eq('id', editingUser.id);

        if (updateError) throw updateError;

      // ============================================================
      // PERSONAL PLAN - NO team, save to profiles table
      // ============================================================
      } else if (isPersonal) {
        console.log('👤 Personal plan - NO team needed');
        console.log('📝 Saving subscription to profiles table...');

        // If user currently has a team (group), remove them from it
        if (teamId) {
          console.log('🔄 User has existing team - removing from group...');
          
          // Check if team has other members
          const { data: members, error: membersError } = await supabase
            .from('profiles')
            .select('id')
            .eq('team_id', teamId)
            .neq('id', editingUser.id);

          if (!membersError && members && members.length > 0) {
            console.log('👥 Team has other members - just removing this user');
          } else {
            console.log('👤 User is the only member - deleting team');
            await supabase
              .from('teams')
              .delete()
              .eq('id', teamId);
          }
        }

        // Save personal subscription to profiles table
        const { error: updateError } = await supabase
          .from('profiles')
          .update({ 
            team_id: null,
            role: editingUser.role || 'member',
            subscription_tier: editTier,
            subscription_expiry: editExpiryDate.toISOString()
          })
          .eq('id', editingUser.id);

        if (updateError) throw updateError;
        
        console.log('✅ Personal subscription saved to profiles table');
        console.log(`   Tier: ${editTier}`);
        console.log(`   Expiry: ${editExpiryDate.toISOString()}`);
      }

      // Update user's role if changed
      if (editingUser.role !== editRole) {
        const { error: roleError } = await supabase
          .from('profiles')
          .update({ role: editRole })
          .eq('id', editingUser.id);

        if (roleError) throw roleError;
      }

      Alert.alert('Success', `Subscription updated successfully for ${editingUser.full_name || editingUser.email}`);
      setShowEditModal(false);
      setEditingUser(null);
      loadData();
      // Also refresh the main app data
      if (onRefresh) onRefresh();

    } catch (error) {
      console.error('❌ Update subscription error:', error);
      Alert.alert('Error', 'Failed to update subscription: ' + error.message);
    }
  };

  // ============================================================
  // REMOVE USER FROM GROUP
  // ============================================================
  const handleRemoveFromGroup = (userId, userName) => {
    Alert.alert(
      'Remove from Group',
      `Remove ${userName || 'this user'} from their group?\n\nThis will set them to Personal Free.`,
      [
        { text: 'Cancel', style: 'cancel' },
        {
          text: 'Remove',
          style: 'destructive',
          onPress: async () => {
            try {
              const { data: userProfile, error: profileError } = await supabase
                .from('profiles')
                .select('team_id')
                .eq('id', userId)
                .single();

              if (profileError) throw profileError;

              if (userProfile.team_id) {
                const { data: members, error: membersError } = await supabase
                  .from('profiles')
                  .select('id')
                  .eq('team_id', userProfile.team_id)
                  .neq('id', userId);

                if (!membersError && members && members.length > 0) {
                  console.log('👥 Team has other members, removing only this user');
                } else {
                  console.log('👤 User is the only member, deleting team');
                  await supabase
                    .from('teams')
                    .delete()
                    .eq('id', userProfile.team_id);
                }
              }

              const { error } = await supabase
                .from('profiles')
                .update({ 
                  team_id: null, 
                  role: 'member',
                  subscription_tier: 'personal_free',
                  subscription_expiry: null
                })
                .eq('id', userId);

              if (error) throw error;

              Alert.alert('Success', `${userName} removed from group and set to Personal Free`);
              loadData();
            } catch (error) {
              console.error('❌ Remove from group error:', error);
              Alert.alert('Error', 'Failed to remove user: ' + error.message);
            }
          }
        }
      ]
    );
  };

  // ============================================================
  // DELETE TRIP
  // ============================================================
  const handleDeleteTrip = (tripId, userName) => {
    Alert.alert(
      'Delete Trip',
      `Are you sure you want to delete this trip for ${userName || 'user'}?`,
      [
        { text: 'Cancel', style: 'cancel' },
        {
          text: 'Delete',
          style: 'destructive',
          onPress: async () => {
            try {
              const { error } = await supabase
                .from('trip_logs')
                .delete()
                .eq('id', tripId);

              if (error) throw error;

              Alert.alert('Success', 'Trip deleted successfully');
              loadData();
            } catch (error) {
              console.error('❌ Delete trip error:', error);
              Alert.alert('Error', 'Failed to delete trip: ' + error.message);
            }
          }
        }
      ]
    );
  };

  // ============================================================
  // UPDATE USER
  // ============================================================
  const handleUpdateUser = async () => {
    if (!editingUser) return;

    try {
      const { error } = await supabase
        .from('profiles')
        .update({
          full_name: editName,
          role: editRole,
          email: editEmail
        })
        .eq('id', editingUser.id);

      if (error) throw error;

      Alert.alert('Success', 'User updated successfully');
      setShowEditModal(false);
      setEditingUser(null);
      loadData();
    } catch (error) {
      console.error('❌ Update user error:', error);
      Alert.alert('Error', 'Failed to update user: ' + error.message);
    }
  };

  // ============================================================
  // DELETE USER
  // ============================================================
  const handleDeleteUser = (userId, userName) => {
    Alert.alert(
      'Delete User',
      `Are you sure you want to delete user ${userName || 'this user'} and all their trips?`,
      [
        { text: 'Cancel', style: 'cancel' },
        {
          text: 'Delete User',
          style: 'destructive',
          onPress: async () => {
            try {
              await supabase
                .from('trip_logs')
                .delete()
                .eq('user_id', userId);

              await supabase
                .from('referral_codes')
                .delete()
                .eq('user_id', userId);

              const { error } = await supabase
                .from('profiles')
                .delete()
                .eq('id', userId);

              if (error) throw error;

              Alert.alert('Success', `User ${userName} deleted successfully`);
              loadData();
            } catch (error) {
              console.error('❌ Delete user error:', error);
              Alert.alert('Error', 'Failed to delete user: ' + error.message);
            }
          }
        }
      ]
    );
  };

  // ============================================================
  // RENDER FUNCTIONS
  // ============================================================
  const renderFeedback = () => (
    <View style={{ padding: 16 }}>
      <Text style={{ fontSize: 18, fontWeight: 'bold', marginBottom: 12 }}>
        💬 Feedback ({feedback.length})
      </Text>
      {feedback.length === 0 ? (
        <Text style={{ color: '#888', paddingVertical: 20, textAlign: 'center' }}>
          No feedback yet.
        </Text>
      ) : (
        feedback.map((item) => (
          <View
            key={item.id}
            style={{
              backgroundColor: '#fff',
              borderRadius: 10,
              padding: 14,
              marginBottom: 10,
              elevation: 1,
            }}
          >
            <View style={{ flexDirection: 'row', justifyContent: 'space-between', marginBottom: 4 }}>
              <Text style={{ fontWeight: 'bold', color: '#333' }}>
                {item.category === 'bug' ? '🐞' :
                 item.category === 'feature' ? '💡' :
                 item.category === 'general' ? '💬' : '📝'} {item.category}
              </Text>
              <Text style={{ fontSize: 12, color: '#888' }}>
                {new Date(item.created_at).toLocaleString()}
              </Text>
            </View>
            <Text style={{ fontSize: 12, color: '#666', marginBottom: 6 }}>
              {item.email || 'unknown'}
            </Text>
            <Text style={{ fontSize: 14, color: '#111', lineHeight: 20 }}>
              {item.message}
            </Text>
            {item.platform && (
              <Text style={{ fontSize: 11, color: '#aaa', marginTop: 6 }}>
                {item.platform} • v{item.app_version || '1.0.0'}
              </Text>
            )}
          </View>
        ))
      )}
    </View>
  );

  const renderDashboard = () => (
    <View style={styles.statsContainer}>
      <View style={styles.statCard}>
        <Text style={styles.statNumber}>{stats.totalUsers || 0}</Text>
        <Text style={styles.statLabel}>Total Users</Text>
      </View>
      <View style={styles.statCard}>
        <Text style={styles.statNumber}>{stats.totalTrips || 0}</Text>
        <Text style={styles.statLabel}>Total Trips</Text>
      </View>
      <View style={styles.statCard}>
        <Text style={styles.statNumber}>{stats.totalDistance || 0} km</Text>
        <Text style={styles.statLabel}>Total Distance</Text>
      </View>
      <View style={styles.statCard}>
        <Text style={styles.statNumber}>{stats.totalTeams || 0}</Text>
        <Text style={styles.statLabel}>Total Groups</Text>
      </View>
    </View>
  );

  const renderUsers = () => (
    <View style={styles.listContainer}>
      <Text style={styles.listTitle}>👥 All Users ({users.length})</Text>
      <FlatList
        data={users}
        keyExtractor={(item) => item.id}
        renderItem={({ item }) => (
          <View style={styles.listItem}>
            <View style={styles.listItemContent}>
              <Text style={styles.listItemName}>{item.full_name || 'Unknown'}</Text>
              <Text style={styles.listItemEmail}>{item.email}</Text>
              <View style={styles.listItemBadges}>
                <Text style={[styles.badge, item.role === 'admin' && styles.badgeAdmin]}>
                  {item.role || 'member'}
                </Text>
                {item.team_id && (
                  <Text style={styles.badgeGroup}>👥 Group</Text>
                )}
              </View>
              <View style={styles.subscriptionBadge}>
                <Text style={styles.badgePlan}>📊 {item.subscription_tier || 'Personal Free'}</Text>
                {item.subscription_end_date && (
                  <Text style={styles.badgeExpiry}>
                    ⏰ {new Date(item.subscription_end_date).toLocaleDateString()}
                  </Text>
                )}
              </View>
            </View>
            <View style={styles.listItemActions}>
              <TouchableOpacity
                style={[styles.actionBtn, styles.editBtn]}
                onPress={() => {
                  setEditingUser(item);
                  setEditName(item.full_name || '');
                  setEditRole(item.role || 'member');
                  setEditEmail(item.email || '');
                  setEditTeamId(item.team_id || '');
                  setEditTier(item.subscription_tier ? 
                    Object.keys(SUBSCRIPTION_TIERS).find(k => SUBSCRIPTION_TIERS[k].label === item.subscription_tier) : 
                    'personal_free');
                  setEditExpiryDate(item.subscription_end_date ? new Date(item.subscription_end_date) : new Date(Date.now() + 30 * 24 * 60 * 60 * 1000));
                  setShowEditModal(true);
                }}
              >
                <Text style={styles.actionBtnText}>✏️</Text>
              </TouchableOpacity>
              {item.team_id && (
                <TouchableOpacity
                  style={[styles.actionBtn, styles.removeBtn]}
                  onPress={() => handleRemoveFromGroup(item.id, item.full_name || item.email)}
                >
                  <Text style={styles.actionBtnText}>🚫</Text>
                </TouchableOpacity>
              )}
              <TouchableOpacity
                style={[styles.actionBtn, styles.deleteBtn]}
                onPress={() => handleDeleteUser(item.id, item.full_name || item.email)}
              >
                <Text style={styles.actionBtnText}>🗑️</Text>
              </TouchableOpacity>
            </View>
          </View>
        )}
        refreshControl={
          <RefreshControl refreshing={refreshing} onRefresh={onRefresh} />
        }
        ListEmptyComponent={
          <Text style={styles.emptyText}>No users found</Text>
        }
      />
    </View>
  );

  const renderTrips = () => (
    <View style={styles.listContainer}>
      <Text style={styles.listTitle}>📋 Recent Trips ({trips.length})</Text>
      <FlatList
        data={trips}
        keyExtractor={(item) => item.id}
        renderItem={({ item }) => (
          <View style={styles.tripItem}>
            <View style={styles.tripContent}>
              <Text style={styles.tripUser}>
                {item.profiles?.full_name || item.profiles?.email || 'Unknown User'}
              </Text>
              <Text style={styles.tripDetails}>
                📍 {item.from_address || 'N/A'} → {item.to_address || 'N/A'}
              </Text>
              <Text style={styles.tripMeta}>
                📅 {new Date(item.trip_date).toLocaleDateString()} • 📏 {item.distance_km || 0} km
              </Text>
            </View>
            <TouchableOpacity
              style={[styles.actionBtn, styles.deleteBtn]}
              onPress={() => handleDeleteTrip(item.id, item.profiles?.full_name || 'user')}
            >
              <Text style={styles.actionBtnText}>🗑️</Text>
            </TouchableOpacity>
          </View>
        )}
        refreshControl={
          <RefreshControl refreshing={refreshing} onRefresh={onRefresh} />
        }
        ListEmptyComponent={
          <Text style={styles.emptyText}>No trips found</Text>
        }
      />
    </View>
  );

  const renderTeams = () => (
    <View style={styles.listContainer}>
      <Text style={styles.listTitle}>🏢 All Groups ({teams.length})</Text>
      <FlatList
        data={teams}
        keyExtractor={(item) => item.id}
        renderItem={({ item }) => (
          <View style={styles.listItem}>
            <View style={styles.listItemContent}>
              <Text style={styles.listItemName}>{item.name || 'Unnamed Group'}</Text>
              <Text style={styles.listItemEmail}>
                👤 {item.profiles?.full_name || item.profiles?.email || 'Unknown admin'}
              </Text>
              <View style={styles.listItemBadges}>
                <Text style={styles.badgePlan}>{item.subscription_tier || 'Free'}</Text>
                <Text style={styles.badgeGroup}>👥 Max: {item.max_members || 1}</Text>
                {item.subscription_end_date && (
                  <Text style={styles.badgeExpiry}>
                    ⏰ {new Date(item.subscription_end_date).toLocaleDateString()}
                  </Text>
                )}
              </View>
            </View>
          </View>
        )}
        refreshControl={
          <RefreshControl refreshing={refreshing} onRefresh={onRefresh} />
        }
        ListEmptyComponent={
          <Text style={styles.emptyText}>No groups found</Text>
        }
      />
    </View>
  );

  if (loading) {
    return (
      <Modal visible={true} animationType="slide" transparent={false}>
        <View style={styles.loadingContainer}>
          <ActivityIndicator size="large" color="#007AFF" />
          <Text style={styles.loadingText}>Loading Admin Panel...</Text>
        </View>
      </Modal>
    );
  }

  return (
    <Modal visible={true} animationType="slide" transparent={false}>
      <View style={styles.container}>
        <View style={styles.header}>
          <Text style={styles.title}>🔐 Admin Panel</Text>
          <TouchableOpacity style={styles.closeBtn} onPress={onClose}>
            <Text style={styles.closeBtnText}>✕</Text>
          </TouchableOpacity>
        </View>

        <View style={styles.navBar}>
          <TouchableOpacity
            style={[styles.navBtn, view === 'dashboard' && styles.navBtnActive]}
            onPress={() => setView('dashboard')}
          >
            <Text style={[styles.navBtnText, view === 'dashboard' && styles.navBtnTextActive]}>📊</Text>
          </TouchableOpacity>
          <TouchableOpacity
            style={[styles.navBtn, view === 'users' && styles.navBtnActive]}
            onPress={() => setView('users')}
          >
            <Text style={[styles.navBtnText, view === 'users' && styles.navBtnTextActive]}>👥</Text>
          </TouchableOpacity>
          <TouchableOpacity
            style={[styles.navBtn, view === 'trips' && styles.navBtnActive]}
            onPress={() => setView('trips')}
          >
            <Text style={[styles.navBtnText, view === 'trips' && styles.navBtnTextActive]}>📋</Text>
          </TouchableOpacity>
          <TouchableOpacity
            style={[styles.navBtn, view === 'teams' && styles.navBtnActive]}
            onPress={() => setView('teams')}
          >
             <Text style={[styles.navBtnText, view === 'teams' && styles.navBtnTextActive]}>🏢</Text>
          </TouchableOpacity>
          <TouchableOpacity
            style={[styles.navBtn, view === 'feedback' && styles.navBtnActive]}
            onPress={() => setView('feedback')}
          >
            <Text style={[styles.navBtnText, view === 'feedback' && styles.navBtnTextActive]}>💬</Text>
          </TouchableOpacity>
        </View>

        <ScrollView
          style={styles.content}
          refreshControl={
            <RefreshControl refreshing={refreshing} onRefresh={onRefresh} />
          }
        >
          {view === 'dashboard' && renderDashboard()}
          {view === 'users' && renderUsers()}
          {view === 'trips' && renderTrips()}
          {view === 'teams' && renderTeams()}
          {view === 'feedback' && renderFeedback()}
        </ScrollView>

        {/* Edit User Modal */}
        <Modal visible={showEditModal} animationType="slide" transparent={true}>
          <View style={styles.modalOverlay}>
            <ScrollView style={styles.modalContent} showsVerticalScrollIndicator={false}>
              <Text style={styles.modalTitle}>✏️ Edit User & Subscription</Text>

              <Text style={styles.inputLabel}>Full Name</Text>
              <TextInput
                style={styles.input}
                value={editName}
                onChangeText={setEditName}
                placeholder="Full name"
              />

              <Text style={styles.inputLabel}>Email</Text>
              <TextInput
                style={styles.input}
                value={editEmail}
                onChangeText={setEditEmail}
                placeholder="Email"
                keyboardType="email-address"
              />

              <Text style={styles.inputLabel}>Role</Text>
              <View style={styles.roleSelector}>
                {['member', 'admin', 'leader'].map((role) => (
                  <TouchableOpacity
                    key={role}
                    style={[
                      styles.roleBtn,
                      editRole === role && styles.roleBtnActive
                    ]}
                    onPress={() => setEditRole(role)}
                  >
                    <Text style={[
                      styles.roleBtnText,
                      editRole === role && styles.roleBtnTextActive
                    ]}>
                      {role.toUpperCase()}
                    </Text>
                  </TouchableOpacity>
                ))}
              </View>

              <Text style={styles.inputLabel}>Subscription Plan</Text>
              <View style={styles.subscriptionSelector}>
                {SUBSCRIPTION_TIERS.map((tier) => (
                  <TouchableOpacity
                    key={tier.value}
                    style={[
                      styles.subscriptionBtn,
                      editTier === tier.value && styles.subscriptionBtnActive
                    ]}
                    onPress={() => setEditTier(tier.value)}
                  >
                    <Text style={[
                      styles.subscriptionBtnText,
                      editTier === tier.value && styles.subscriptionBtnTextActive
                    ]}>
                      {tier.label.replace('Personal ', 'P').replace('Group ', 'G')}
                    </Text>
                  </TouchableOpacity>
                ))}
              </View>

              <Text style={styles.inputLabel}>Team ID (for group plans only)</Text>
              <TextInput
                style={styles.input}
                value={editTeamId}
                onChangeText={setEditTeamId}
                placeholder="Leave empty for personal plans"
              />

              <Text style={styles.inputLabel}>Expiry Date</Text>
              <TouchableOpacity
                style={styles.datePickerButton}
                onPress={() => setShowDatePicker(true)}
              >
                <Text style={styles.datePickerText}>
                  {editExpiryDate ? editExpiryDate.toLocaleDateString() : 'Select date'}
                </Text>
              </TouchableOpacity>

              {showDatePicker && (
                <DateTimePicker
                  value={editExpiryDate || new Date()}
                  mode="date"
                  display="default"
                  onChange={(event, selectedDate) => {
                    setShowDatePicker(false);
                    if (selectedDate) {
                      setEditExpiryDate(selectedDate);
                    }
                  }}
                />
              )}

              <View style={styles.modalActions}>
                <TouchableOpacity
                  style={[styles.modalBtn, styles.cancelModalBtn]}
                  onPress={() => {
                    setShowEditModal(false);
                    setEditingUser(null);
                  }}
                >
                  <Text style={styles.cancelModalBtnText}>Cancel</Text>
                </TouchableOpacity>
                <TouchableOpacity
                  style={[styles.modalBtn, styles.saveModalBtn]}
                  onPress={handleUpdateSubscription}
                >
                  <Text style={styles.saveModalBtnText}>Save All</Text>
                </TouchableOpacity>
              </View>
            </ScrollView>
          </View>
        </Modal>
      </View>
    </Modal>
  );
};

