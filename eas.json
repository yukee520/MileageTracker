{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "gradleProperties": {
          "hermesEnabled": "false"
        }
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleProperties": {
          "hermesEnabled": "false"
        }
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle",
        "gradleProperties": {
          "hermesEnabled": "false"
        }
      }
    }
  },
  "submit": {
    "production": {}
  }
}
