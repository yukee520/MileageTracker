{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleProperties": {
          "hermesEnabled": "false"
        }
      },
      "env": {
        "EXPO_USE_HERMES": "false"
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle",
        "gradleProperties": {
          "hermesEnabled": "false"
        }
      },
      "env": {
        "EXPO_USE_HERMES": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
