import { supabase } from '../lib/supabase';

const MAX_FREE_MONTHS_PER_USER = 1;
const FREE_MONTHS_PER_REFERRAL = 1;

function buildReferralCode(nameOrEmail) {
  const base = (nameOrEmail || 'REF').toString().replace(/[^A-Za-z]/g, '').toUpperCase();
  const namePart = base.substring(0, 3).padEnd(3, 'X');
  const randomPart = Math.random().toString(36).substring(2, 8).toUpperCase();
  return `${namePart}-${randomPart}`;
}

function addOneMonth(fromDate) {
  const d = new Date(fromDate);
  d.setMonth(d.getMonth() + 1);
  return d;
}

class ReferralService {
  // ============================================================
  // GET REFERRAL CODE (creates one if missing; live counters)
  // ============================================================
  static async getReferralCode(userId) {
    try {
      const { data, error } = await supabase
        .from('profiles')
        .select('id, email, full_name, referral_code, referral_count, free_months_earned, referral_rewards_used, referred_by')
        .eq('id', userId)
        .single();

      if (error) throw error;
      if (!data) return null;

      if (!data.referral_code) {
        const newCode = buildReferralCode(data.full_name || data.email);
        const { data: updated, error: updErr } = await supabase
          .from('profiles')
          .update({ referral_code: newCode })
          .eq('id', userId)
          .select()
          .single();

        if (updErr) throw updErr;
        return updated;
      }

      // Live counters from reward rows
      const { count: totalCount } = await supabase
        .from('referral_rewards')
        .select('*', { count: 'exact', head: true })
        .eq('user_id', userId);

      const { count: usedCount } = await supabase
        .from('referral_rewards')
        .select('*', { count: 'exact', head: true })
        .eq('user_id', userId)
        .eq('status', 'used');

      return {
        ...data,
        free_months_earned: totalCount || 0,
        referral_rewards_used: usedCount || 0,
      };
    } catch (error) {
      console.error('Error getting referral code:', error);
      return null;
    }
  }

  // ============================================================
  // GENERATE REFERRAL CODE
  // ============================================================
  static async generateReferralCode(userId, userName) {
    try {
      const { data: existing, error: checkError } = await supabase
        .from('profiles')
        .select('id, referral_code')
        .eq('id', userId)
        .single();

      if (checkError) throw checkError;

      if (existing?.referral_code) {
        return { success: true, message: 'Code already exists', data: existing };
      }

      const code = buildReferralCode(userName);
      const { data, error } = await supabase
        .from('profiles')
        .update({ referral_code: code })
        .eq('id', userId)
        .select()
        .single();

      if (error) throw error;
      return { success: true, message: 'Referral code generated', data };
    } catch (error) {
      console.error('Error generating referral code:', error);
      return { success: false, error: error.message };
    }
  }

  // ============================================================
  // APPLY REFERRAL CODE (called when new user enters a code)
  // ============================================================
  static async applyReferral(code, userId) {
    try {
      const cleanCode = (code || '').trim().toUpperCase();

      if (!cleanCode) {
        return { success: false, error: 'Please enter a referral code' };
      }

      const { data: referrer, error: referrerErr } = await supabase
        .from('profiles')
        .select('id, email, full_name, referral_code')
        .eq('referral_code', cleanCode)
        .maybeSingle();

      if (referrerErr) throw referrerErr;

      if (!referrer) {
        return { success: false, error: 'Invalid referral code' };
      }

      if (referrer.id === userId) {
        return { success: false, error: 'You cannot use your own referral code' };
      }

      // Referrer cap check (count pending + used rows)
      const { count: referrerRewards } = await supabase
        .from('referral_rewards')
        .select('*', { count: 'exact', head: true })
        .eq('user_id', referrer.id);

      if ((referrerRewards || 0) >= MAX_FREE_MONTHS_PER_USER) {
        return {
          success: false,
          error: 'This referrer has already received their free month'
        };
      }

      const { data: me, error: meErr } = await supabase
        .from('profiles')
        .select('id, referred_by')
        .eq('id', userId)
        .single();

      if (meErr) throw meErr;

      if (me.referred_by) {
        return { success: false, error: 'You have already used a referral code' };
      }

      const { error: updateErr } = await supabase
        .from('profiles')
        .update({ referred_by: referrer.id })
        .eq('id', userId);

      if (updateErr) throw updateErr;

      return {
        success: true,
        message: 'Referral code applied! Your friend will be rewarded after you complete your first trip.',
        referrerId: referrer.id
      };
    } catch (error) {
      console.error('Error applying referral:', error);
      return { success: false, error: error.message };
    }
  }

  // ============================================================
  // CHECK AND REWARD — calls the security-definer RPC
  // ============================================================
  static async checkAndRewardReferral(userId) {
    try {
      console.log('🎁 ReferralService: RPC starting for', userId);
      const { data, error } = await supabase.rpc('award_referral_for_new_user');
      console.log('🎁 ReferralService: RPC raw — data:', JSON.stringify(data), 'error:', JSON.stringify(error));

      if (error) throw error;

      if (!data || data.success !== true) {
        return {
          success: false,
          message: data?.message || data?.error || 'Reward not issued'
        };
      }

      return {
        success: true,
        message: 'Referral reward created. The referrer can redeem it in the app.'
      };
    } catch (error) {
      console.error('Error in checkAndRewardReferral:', error);
      return { success: false, error: error.message };
    }
  }

  // ============================================================
  // GET REWARDS HISTORY
  // ============================================================
  static async getRewardsHistory(userId) {
    try {
      const { data, error } = await supabase
        .from('referral_rewards')
        .select('*')
        .eq('user_id', userId)
        .order('created_at', { ascending: false });

      if (error) throw error;
      return data || [];
    } catch (error) {
      console.error('Error getting rewards history:', error);
      return [];
    }
  }

  // ============================================================
  // COUNT AVAILABLE (pending) MONTHS
  // ============================================================
  static async getAvailableMonths(userId) {
    try {
      const { count, error } = await supabase
        .from('referral_rewards')
        .select('*', { count: 'exact', head: true })
        .eq('user_id', userId)
        .eq('status', 'pending');

      if (error) throw error;
      return count || 0;
    } catch (error) {
      console.error('Error counting available months:', error);
      return 0;
    }
  }

  // ============================================================
  // REDEEM FREE MONTH
  // - personal_free → upgrade to personal_basic for 1 month
  // - any paid tier → extend subscription_expiry by 1 month
  // ============================================================
  static async redeemFreeMonth(userId) {
    try {
      const { data: pending, error: pendingErr } = await supabase
        .from('referral_rewards')
        .select('*')
        .eq('user_id', userId)
        .eq('status', 'pending')
        .order('created_at', { ascending: true })
        .limit(1)
        .maybeSingle();

      if (pendingErr) throw pendingErr;

      if (!pending) {
        return { success: false, error: 'No free months available to redeem' };
      }

      const { data: profile, error: profileErr } = await supabase
        .from('profiles')
        .select('subscription_tier, subscription_expiry, referral_rewards_used')
        .eq('id', userId)
        .single();

      if (profileErr) throw profileErr;

      const currentTier = profile.subscription_tier || 'personal_free';
      const now = new Date();
      const currentExpiry = profile.subscription_expiry ? new Date(profile.subscription_expiry) : null;

      const isPaid = ['personal_basic', 'personal_pro', 'team_basic', 'team_pro'].includes(currentTier);

      let nextTier;
      let nextExpiry;

      if (isPaid) {
        const base = currentExpiry && currentExpiry > now ? currentExpiry : now;
        nextTier = currentTier;
        nextExpiry = addOneMonth(base);
      } else {
        nextTier = 'personal_basic';
        nextExpiry = addOneMonth(now);
      }

      const { error: updateProfileErr } = await supabase
        .from('profiles')
        .update({
          subscription_tier: nextTier,
          subscription_expiry: nextExpiry.toISOString(),
          referral_rewards_used: (profile.referral_rewards_used || 0) + 1
        })
        .eq('id', userId);

      if (updateProfileErr) throw updateProfileErr;

      const { error: useErr } = await supabase
        .from('referral_rewards')
        .update({ status: 'used', used_at: new Date().toISOString() })
        .eq('id', pending.id);

      if (useErr) throw useErr;

      return {
        success: true,
        message: `Free month applied! You are now on ${nextTier} until ${nextExpiry.toLocaleDateString()}.`,
        tier: nextTier,
        expiresAt: nextExpiry.toISOString()
      };
    } catch (error) {
      console.error('Error redeeming free month:', error);
      return { success: false, error: error.message };
    }
  }

  // ============================================================
  // APPLY FREE MONTH (compat alias)
  // ============================================================
  static async applyFreeMonth(userId) {
    return this.redeemFreeMonth(userId);
  }

  // ============================================================
  // REFERRAL STATS (admin)
  // ============================================================
  static async getReferralStats() {
    try {
      const { data, error } = await supabase
        .from('referral_rewards')
        .select('*')
        .order('created_at', { ascending: false });

      if (error) throw error;

      const rows = data || [];
      return {
        totalReferrals: rows.length,
        totalFreeMonthsEarned: rows.reduce((s, r) => s + (r.amount || 1), 0),
        totalRedeemed: rows.filter(r => r.status === 'used').length,
        totalPending: rows.filter(r => r.status === 'pending').length,
        data: rows
      };
    } catch (error) {
      console.error('Error getting referral stats:', error);
      return null;
    }
  }
}

export default ReferralService;
